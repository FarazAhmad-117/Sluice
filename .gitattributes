# Line endings
#
# Everything git decides is text is stored with LF in the repository and is
# checked out with LF in every working tree, on every platform. Without this a
# Windows checkout commits CRLF, and the first patch from a Linux contributor
# shows every line of the file as changed.

* text=auto eol=lf

# Files that must keep LF even where a tool might disagree, because something
# other than git reads them and CRLF breaks it.

*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf

# Windows-only scripts keep CRLF. cmd.exe mis-parses LF-only batch files.

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary. Listed explicitly so git never tries to normalise or diff them.

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.webp          binary
*.avif          binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.tgz           binary
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.eot           binary
*.mp4           binary
*.mov           binary
*.webm          binary
*.wasm          binary

# SVG is text, but it is usually generated and rarely worth reading in a diff.

*.svg           text eol=lf linguist-detectable=false

# The lockfile is generated. Keep it as LF text so it merges, but keep it out
# of diffs and out of the language statistics, where it would otherwise drown
# every real change in a pull request.

pnpm-lock.yaml  text eol=lf -diff linguist-generated=true
