{
  "name": "sluice",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "turbo run dev --continue",
    "dev:backend": "convex dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:all": "pnpm -r --include-workspace-root test",
    "typecheck:all": "pnpm -r --include-workspace-root typecheck",
    "build": "pnpm -r build"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@sluice/crypto": "workspace:*",
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.3",
    "convex-test": "^0.0.58",
    "turbo": "^2.11.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^2.1.9"
  }
}
