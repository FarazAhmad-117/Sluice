# Not required for a local checkout, and not secret.
# Copy to .env.local to override.

# Where "Sign in" and "Get started" point: the admin panel's origin, with no
# trailing slash. The admin panel is a separate application (apps/admin), so
# these cannot be relative links.
#
# Defaults to http://localhost:5180, which is where `pnpm --filter admin dev`
# serves it.
# NEXT_PUBLIC_ADMIN_URL=https://admin.sluice.dev
